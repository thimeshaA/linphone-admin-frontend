# Copy to .env.local for local development. Placeholder values only.

# REQUIRED AT BUILD TIME. Domain used when provisioning a new SIP account (see
# account-dialogs.tsx). Next.js inlines it into the client bundle during
# `next build`, so `next build` fails without it; the container build takes it
# as `--build-arg NEXT_PUBLIC_SIP_DOMAIN=...` and changing it needs a rebuild.
NEXT_PUBLIC_SIP_DOMAIN=sip.example.invalid

# Run time, server-side only. Backend origin that proxy.ts rewrites same-origin
# /api/* requests to, in every environment (dev and production).
BACKEND_URL=http://localhost:4000

# Opts out of Next.js' anonymous usage telemetry (sent to Vercel on build/dev/
# start). Required by company policy: this project must not make any outbound
# calls to third parties. Do not remove this — Next.js re-enables telemetry by
# default the moment this var is absent. Set it in every environment that runs
# `next build`/`next dev`/`next start` (local .env.local, CI, and the container
# image, which sets it in both the builder and runner stages).
NEXT_TELEMETRY_DISABLED=1
