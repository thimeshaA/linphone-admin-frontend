# Base URL the browser uses to reach the backend API directly.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Backend origin used by next.config.mjs (via proxy.ts) to rewrite same-origin
# /api/* requests to the Express backend during local development, avoiding CORS.
BACKEND_URL=https://admin-panel.prometeolk.com

# Opts out of Next.js' anonymous usage telemetry (sent to Vercel on build/dev/
# start). Required by company policy: this project must not make any outbound
# calls to third parties. Do not remove this — Next.js re-enables telemetry by
# default the moment this var is absent. Set it in every environment that runs
# `next build`/`next dev`/`next start` (local .env.local, CI, and the actual
# deployment platform's env var settings), since it must be present in each
# place independently.
NEXT_TELEMETRY_DISABLED=1
